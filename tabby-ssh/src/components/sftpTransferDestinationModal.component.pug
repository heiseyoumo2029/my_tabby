.modal-header
    h4.modal-title(translate) Choose destination directory
    button.btn-close(type='button', (click)='cancel()', aria-label='Close')
.modal-body
    div.mb-2 {{target}}
    div.mb-3 {{fileName}}
    label.form-label(for='sftp-transfer-destination', translate) Enter destination directory on the remote host
    input#sftp-transfer-destination.form-control(
        type='text',
        [(ngModel)]='destinationPath',
        (keyup.enter)='confirm()',
        autofocus
        placeholder='/home/user/directory'
    )
    .d-flex.flex-wrap.gap-2.mt-2
        button.btn.btn-sm.btn-outline-secondary(type='button', *ngIf='shellPath', (click)='destinationPath = shellPath', translate) Terminal directory
        button.btn.btn-sm.btn-outline-secondary(type='button', (click)='destinationPath = sftpPath', translate) SFTP directory
        button.btn.btn-sm.btn-outline-secondary(type='button', (click)='loadTmuxPanes()', [disabled]='loadingPanes', translate) Select tmux pane
    select.form-select.form-select-sm.mt-2(*ngIf='panes.length', #pane, (change)='selectTmuxPane(pane.value)')
        option(value='', selected, disabled, translate) Choose a tmux pane
        option(*ngFor='let item of panes', [value]='item.id') {{item.label}}
    .text-danger.mt-2(*ngIf='error') {{error}}
.modal-footer
    button.btn.btn-primary(type='button', (click)='confirm()', [disabled]='checking', translate) Transfer
    button.btn.btn-secondary(type='button', (click)='cancel()', translate) Cancel
